VITE_API_URL=http://localhost:4100

# Which social login providers the API has OAuth credentials for. When set, the
# auth form renders those buttons on first paint instead of waiting for the
# /api/auth-providers probe. Leave unset for local dev — the form then probes at
# runtime and shows skeletons until the answer lands.
# VITE_AUTH_GOOGLE=true
# VITE_AUTH_GITHUB=true
